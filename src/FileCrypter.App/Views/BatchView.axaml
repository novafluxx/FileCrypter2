<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FileCrypter.App.ViewModels"
             x:Class="FileCrypter.App.Views.BatchView"
             x:DataType="vm:BatchViewModel">
    <ScrollViewer>
        <StackPanel Spacing="24" MaxWidth="1000">
            <Border IsVisible="{Binding HasError}"
                    Background="{DynamicResource ErrorBackgroundBrush}"
                    BorderBrush="{DynamicResource ErrorBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="24,18">
                <StackPanel Spacing="12">
                    <TextBlock Text="{Binding VisibleErrorMessage}"
                               Foreground="{DynamicResource ErrorForegroundBrush}"
                               FontSize="{StaticResource FontSizeTitle}"
                               TextWrapping="Wrap" />
                    <Button Content="Copy issue"
                            Command="{Binding CopyErrorCommand}"
                            HorizontalAlignment="Left" />
                </StackPanel>
            </Border>

            <Border Background="{DynamicResource SurfaceBackgroundBrush}"
                    BorderBrush="{DynamicResource SurfaceBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="28">
                <StackPanel Spacing="18">
                    <TextBlock Text="WORKFLOW"
                               Foreground="{DynamicResource SectionLabelForegroundBrush}"
                               FontSize="{StaticResource FontSizeBody}"
                               FontWeight="Bold"
                               LetterSpacing="2" />
                    <TextBlock Text="{Binding ModeTitle}"
                               FontSize="{StaticResource FontSizePanelTitle}"
                               FontWeight="SemiBold" />
                    <TextBlock Text="{Binding ModeDescription}"
                               Foreground="{DynamicResource MutedForegroundBrush}"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{Binding WorkflowChooserDescription}"
                               Foreground="{DynamicResource SectionLabelForegroundBrush}"
                               TextWrapping="Wrap" />

                    <Grid ColumnDefinitions="*,1,*" ColumnSpacing="18">
                        <StackPanel Spacing="12">
                            <TextBlock Text="1. WHAT ARE YOU WORKING WITH?"
                                       Foreground="{DynamicResource SectionLabelForegroundBrush}"
                                       FontSize="{StaticResource FontSizeCaption}"
                                       FontWeight="Bold"
                                       LetterSpacing="1.5" />
                            <Border Background="{DynamicResource SurfaceAltBackgroundBrush}"
                                    BorderBrush="{DynamicResource SurfaceAltBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="18">
                                <StackPanel Spacing="8">
                                    <RadioButton Content="Individual files"
                                                 GroupName="BatchWorkflowType"
                                                 IsChecked="{Binding IndividualFilesMode}"
                                                 ToolTip.Tip="{Binding IndividualFilesOptionDescription}" />
                                    <TextBlock Text="{Binding IndividualFilesOptionDescription}"
                                               Foreground="{DynamicResource MutedForegroundBrush}"
                                               Margin="30,0,0,0"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Border Background="{DynamicResource SurfaceAltBackgroundBrush}"
                                    BorderBrush="{DynamicResource SurfaceAltBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="18">
                                <StackPanel Spacing="8">
                                    <RadioButton Content="Encrypted archive"
                                                 GroupName="BatchWorkflowType"
                                                 IsChecked="{Binding ArchiveMode}"
                                                 ToolTip.Tip="{Binding ArchiveModeOptionDescription}" />
                                    <TextBlock Text="{Binding ArchiveModeOptionDescription}"
                                               Foreground="{DynamicResource MutedForegroundBrush}"
                                               Margin="30,0,0,0"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <Border Grid.Column="1"
                                Background="{DynamicResource SurfaceAltBorderBrush}"
                                CornerRadius="1"
                                Margin="0,6" />

                        <StackPanel Grid.Column="2" Spacing="12">
                            <TextBlock Text="2. WHAT SHOULD FILECRYPTER DO?"
                                       Foreground="{DynamicResource SectionLabelForegroundBrush}"
                                       FontSize="{StaticResource FontSizeCaption}"
                                       FontWeight="Bold"
                                       LetterSpacing="1.5" />
                            <Border Background="{DynamicResource SurfaceAltBackgroundBrush}"
                                    BorderBrush="{DynamicResource SurfaceAltBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="18">
                                <StackPanel Spacing="8">
                                    <RadioButton Content="Encrypt"
                                                 GroupName="BatchWorkflowDirection"
                                                 IsChecked="{Binding EncryptMode}"
                                                 ToolTip.Tip="{Binding EncryptActionDescription}" />
                                    <TextBlock Text="{Binding EncryptActionDescription}"
                                               Foreground="{DynamicResource MutedForegroundBrush}"
                                               Margin="30,0,0,0"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Border Background="{DynamicResource SurfaceAltBackgroundBrush}"
                                    BorderBrush="{DynamicResource SurfaceAltBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="18">
                                <StackPanel Spacing="8">
                                    <RadioButton Content="Decrypt"
                                                 GroupName="BatchWorkflowDirection"
                                                 IsChecked="{Binding IsDecryptMode}"
                                                 ToolTip.Tip="{Binding DecryptActionDescription}" />
                                    <TextBlock Text="{Binding DecryptActionDescription}"
                                               Foreground="{DynamicResource MutedForegroundBrush}"
                                               Margin="30,0,0,0"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="{Binding WorkflowKindDescription}"
                               Foreground="{DynamicResource AccentForegroundBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Background="{DynamicResource SurfaceBackgroundBrush}"
                    BorderBrush="{DynamicResource SurfaceBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="28"
                    x:Name="SourceDropZone">
                <StackPanel Spacing="14">
                    <TextBlock Text="{Binding SourceHeading}"
                               Foreground="{DynamicResource SectionLabelForegroundBrush}"
                               FontSize="{StaticResource FontSizeBody}"
                               FontWeight="Bold"
                               LetterSpacing="2" />
                    <TextBlock Text="{Binding FilesSummaryText}"
                               Foreground="{DynamicResource MutedForegroundBrush}"
                               TextWrapping="Wrap" />
                    <TextBlock Text="Click the drop zone or drag local files here."
                               Foreground="{DynamicResource SectionLabelForegroundBrush}"
                               TextWrapping="Wrap" />

                    <Grid ColumnDefinitions="*">
                        <Border Classes="file-drop-zone">
                            <Grid>
                                <StackPanel IsVisible="{Binding ShowEmptySourceState}"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Spacing="6">
                                    <Viewbox Width="28"
                                             Height="28"
                                             HorizontalAlignment="Center">
                                        <Path Classes="file-preview-icon"
                                              Data="M6 2 H14 L20 8 V22 H6 Z M14 2 V8 H20 M12 10 V18 M9 13 L12 10 L15 13 M9 18 H15" />
                                    </Viewbox>
                                    <TextBlock Text="Drop files here to build the batch"
                                               FontSize="{StaticResource FontSizeTitle}"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center" />
                                    <TextBlock Text="Click or drag files here. Each selected file gets its own remove action."
                                               Foreground="{DynamicResource MutedForegroundBrush}"
                                               HorizontalAlignment="Center"
                                               TextWrapping="Wrap" />
                                </StackPanel>

                                <ScrollViewer IsVisible="{Binding HasSelectedFiles}"
                                              MaxHeight="240"
                                              VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding SourceFilePreviews}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:FileSelectionPreviewViewModel">
                                                <Border Classes="file-preview-row"
                                                        Margin="0,0,0,10">
                                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto"
                                                          ColumnSpacing="14"
                                                          VerticalAlignment="Center">
                                                        <Viewbox Width="22"
                                                                 Height="22"
                                                                 VerticalAlignment="Center">
                                                            <Path Classes="file-preview-icon"
                                                                  Data="{Binding IconPathData}" />
                                                        </Viewbox>
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding DisplayName}"
                                                                   ToolTip.Tip="{Binding FullPath}"
                                                                   FontSize="{StaticResource FontSizeTitle}"
                                                                   FontWeight="SemiBold"
                                                                   VerticalAlignment="Center"
                                                                   TextWrapping="NoWrap"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Grid.Column="2"
                                                                   Text="{Binding SizeText}"
                                                                   Foreground="{DynamicResource SectionLabelForegroundBrush}"
                                                                   VerticalAlignment="Center" />
                                                        <Button Grid.Column="3"
                                                                Classes="file-preview-remove"
                                                                Content="x"
                                                                Command="{Binding RemoveCommand}"
                                                                ToolTip.Tip="Remove file from batch" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>
                    <Button Content="Clear list"
                            Command="{Binding ClearFilesCommand}"
                            HorizontalAlignment="Left" />
                </StackPanel>
            </Border>

            <Border Background="{DynamicResource SurfaceBackgroundBrush}"
                    BorderBrush="{DynamicResource SurfaceBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="28">
                <StackPanel Spacing="14">
                    <TextBlock Text="{Binding OutputHeading}"
                               Foreground="{DynamicResource SectionLabelForegroundBrush}"
                               FontSize="{StaticResource FontSizeBody}"
                               FontWeight="Bold"
                               LetterSpacing="2" />
                    <Grid ColumnDefinitions="*,160" ColumnSpacing="16">
                        <TextBox Text="{Binding OutputDirectory}"
                                 PlaceholderText="Choose an existing output folder..."
                                 FontSize="{StaticResource FontSizeInput}" />
                        <Button Grid.Column="1"
                                Content="Browse"
                                Command="{Binding BrowseOutputDirectoryCommand}" />
                    </Grid>

                    <TextBlock Text="{Binding OutputDescription}"
                               Foreground="{DynamicResource MutedForegroundBrush}"
                               TextWrapping="Wrap" />

                    <StackPanel IsVisible="{Binding ShowArchiveNameEditor}"
                                Spacing="10">
                        <TextBlock Text="ARCHIVE NAME"
                                   Foreground="{DynamicResource SectionLabelForegroundBrush}"
                                   FontSize="{StaticResource FontSizeBody}"
                                   FontWeight="Bold"
                                   LetterSpacing="2" />
                        <TextBox Text="{Binding ArchiveName}"
                                 PlaceholderText="Optional archive name, like project-docs"
                                 FontSize="{StaticResource FontSizeInput}" />
                        <TextBlock Text="{Binding ArchiveNameStatusText}"
                                   Foreground="{DynamicResource SectionLabelForegroundBrush}"
                                   Margin="32,0,0,0"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <CheckBox IsChecked="{Binding NeverOverwriteExistingFiles}"
                              Content="Never overwrite existing files" />
                    <TextBlock Text="FileCrypter auto-renames each destination when that folder already contains a matching name."
                               Foreground="{DynamicResource SectionLabelForegroundBrush}"
                               Margin="32,0,0,0"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Background="{DynamicResource SurfaceBackgroundBrush}"
                    BorderBrush="{DynamicResource SurfaceBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="28">
                <StackPanel Spacing="14">
                    <TextBlock Text="PASSWORD AND OPTIONAL KEY FILE"
                               Foreground="{DynamicResource SectionLabelForegroundBrush}"
                               FontSize="{StaticResource FontSizeBody}"
                               FontWeight="Bold"
                               LetterSpacing="2" />
                    <TextBox Text="{Binding Password}"
                             PasswordChar="*"
                             PlaceholderText="Password"
                             FontSize="{StaticResource FontSizeInput}" />

                    <TextBlock Text="{Binding KeyFileChoiceStatusText}"
                               Foreground="{DynamicResource AccentForegroundBrush}"
                               TextWrapping="Wrap" />

                    <Grid ColumnDefinitions="*,140,96" ColumnSpacing="16">
                        <TextBox Text="{Binding KeyFilePath}"
                                 PlaceholderText="Optional batch key file..."
                                 FontSize="{StaticResource FontSizeInput}" />
                        <Button Grid.Column="1"
                                Content="Browse"
                                Command="{Binding BrowseKeyFileCommand}" />
                        <Button Grid.Column="2"
                                Content="Clear"
                                Command="{Binding ClearKeyFileCommand}" />
                    </Grid>

                    <TextBlock Text="If you use a key file here, keep the original file unchanged because FileCrypter will require that same key file later."
                               Foreground="{DynamicResource SectionLabelForegroundBrush}"
                               Margin="32,0,0,0"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Background="{DynamicResource SurfaceBackgroundBrush}"
                    BorderBrush="{DynamicResource SurfaceBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="28">
                <StackPanel Spacing="16">
                    <ProgressBar Minimum="0"
                                 Maximum="100"
                                 Value="{Binding ProgressPercent}" />
                    <TextBlock Text="{Binding ProgressText}"
                               Foreground="{DynamicResource MutedForegroundBrush}"
                               TextWrapping="Wrap" />
                    <Button Content="{Binding ActionButtonText}"
                            Command="{Binding StartBatchCommand}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            FontSize="{StaticResource FontSizeTitle}"
                            FontWeight="SemiBold" />
                </StackPanel>
            </Border>

            <Border IsVisible="{Binding HasResults}"
                    Background="{DynamicResource SurfaceAltBackgroundBrush}"
                    BorderBrush="{DynamicResource SurfaceBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="24,18">
                <StackPanel Spacing="14">
                    <TextBlock Text="{Binding ResultSummary}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource ResultHeadingForegroundBrush}"
                               TextWrapping="Wrap" />
                    <Button Content="Copy results"
                            Command="{Binding CopyResultsCommand}"
                            HorizontalAlignment="Left" />

                    <ItemsControl ItemsSource="{Binding Results}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:BatchResultItemViewModel">
                                <Border Background="{DynamicResource SurfaceBackgroundBrush}"
                                        BorderBrush="{DynamicResource SurfaceAltBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="18"
                                        Margin="0,0,0,12">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="{Binding StatusLabel}"
                                                   Foreground="{Binding StatusBrush}"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding TitleText}"
                                                   FontSize="{StaticResource FontSizeTitle}"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding PrimaryText}"
                                                   Foreground="{DynamicResource MutedForegroundBrush}"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding DetailLabel}"
                                                   Foreground="{DynamicResource SectionLabelForegroundBrush}"
                                                   FontSize="{StaticResource FontSizeCaption}"
                                                   FontWeight="Bold"
                                                   LetterSpacing="1.5" />
                                        <TextBlock Text="{Binding DetailText}"
                                                   Foreground="{Binding DetailBrush}"
                                                   TextWrapping="Wrap" />
                                        <TextBlock IsVisible="{Binding HasSecondaryText}"
                                                   Text="{Binding SecondaryText}"
                                                   Foreground="{DynamicResource SectionLabelForegroundBrush}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
