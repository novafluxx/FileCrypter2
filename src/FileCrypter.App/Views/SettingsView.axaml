<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FileCrypter.App.ViewModels"
             x:Class="FileCrypter.App.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">
    <ScrollViewer>
        <StackPanel Margin="36,30,36,36"
                    Spacing="24"
                    MaxWidth="1120">
            <StackPanel Spacing="10">
                <Border Classes="aurora-panel hero-badge"
                        HorizontalAlignment="Left"
                        Margin="0,0,0,14">
                    <TextBlock Classes="hero-badge-text"
                               Text="{Binding Title}"
                               Foreground="{DynamicResource AccentForegroundBrush}"
                               TextWrapping="Wrap" />
                </Border>
            </StackPanel>

            <Border IsVisible="{Binding HasError}"
                    Background="{DynamicResource ErrorBackgroundBrush}"
                    BorderBrush="{DynamicResource ErrorBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource ControlCornerRadius}"
                    Padding="18,16">
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="{DynamicResource ErrorForegroundBrush}"
                           FontSize="{StaticResource FontSizeTitle}"
                           TextWrapping="Wrap" />
            </Border>

            <Border IsVisible="{Binding HasSuccess}"
                    Background="{DynamicResource SuccessBackgroundBrush}"
                    BorderBrush="{DynamicResource SuccessBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource ControlCornerRadius}"
                    Padding="18,16">
                <TextBlock Text="{Binding SuccessMessage}"
                           Foreground="{DynamicResource SuccessForegroundBrush}"
                           FontSize="{StaticResource FontSizeTitle}"
                           TextWrapping="Wrap" />
            </Border>

            <Grid ColumnDefinitions="*,340"
                  ColumnSpacing="20">
                <StackPanel Spacing="18">
                    <Border Classes="aurora-card">
                        <StackPanel Spacing="18">
                            <TextBlock Text="APPEARANCE"
                                       Foreground="{DynamicResource SectionLabelForegroundBrush}"
                                       FontSize="{StaticResource FontSizeCaption}"
                                       LetterSpacing="2" />
                            <TextBlock Text="Choose whether FileCrypter stays light, stays dark, or follows the platform default."
                                       Foreground="{DynamicResource MutedForegroundBrush}"
                                       TextWrapping="Wrap" />
                            <ComboBox ItemsSource="{Binding ThemeOptions}"
                                      SelectedItem="{Binding ThemePreference}"
                                      HorizontalAlignment="Left"
                                      MinWidth="220" />
                            <TextBlock Text="{Binding ThemePreferenceDescription}"
                                       Foreground="{DynamicResource AccentForegroundBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border Classes="aurora-card">
                        <StackPanel Spacing="18">
                            <TextBlock Text="WORKFLOW DEFAULTS"
                                       Foreground="{DynamicResource SectionLabelForegroundBrush}"
                                       FontSize="{StaticResource FontSizeCaption}"
                                       LetterSpacing="2" />
                            <CheckBox IsChecked="{Binding EnableCompressionByDefault}"
                                      Content="Enable compression by default for single-file encryption" />
                            <TextBlock Text="{Binding CompressionDefaultDescription}"
                                       Foreground="{DynamicResource AccentForegroundBrush}"
                                       Margin="30,0,0,0"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="Compression helps most with text and documents. Photos, videos, ZIP files, and other already-compressed files usually see little benefit."
                                       Foreground="{DynamicResource SectionLabelForegroundBrush}"
                                       Margin="30,0,0,0"
                                       TextWrapping="Wrap" />

                            <CheckBox IsChecked="{Binding NeverOverwriteExistingFilesByDefault}"
                                      Content="Protect existing files by default" />
                            <TextBlock Text="{Binding OverwriteProtectionDescription}"
                                       Foreground="{DynamicResource AccentForegroundBrush}"
                                       Margin="30,0,0,0"
                                       TextWrapping="Wrap" />

                            <StackPanel Spacing="8">
                                <TextBlock Text="DEFAULT OUTPUT DIRECTORY"
                                           Foreground="{DynamicResource SectionLabelForegroundBrush}"
                                           FontSize="{StaticResource FontSizeCaption}"
                                           LetterSpacing="2" />
                                <Grid ColumnDefinitions="*,150"
                                      ColumnSpacing="12">
                                    <TextBox Text="{Binding DefaultOutputDirectory}"
                                             PlaceholderText="Leave blank to use the source file's folder..." />
                                    <Button Grid.Column="1"
                                            Classes="aurora-secondary"
                                            Content="Browse"
                                            Command="{Binding BrowseDefaultOutputDirectoryCommand}" />
                                </Grid>
                                <TextBlock Text="{Binding DefaultOutputDirectoryDescription}"
                                           Foreground="{DynamicResource AccentForegroundBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Classes="aurora-card">
                        <StackPanel Spacing="14">
                            <TextBlock Text="LOCAL SETTINGS FILE"
                                       Foreground="{DynamicResource SectionLabelForegroundBrush}"
                                       FontSize="{StaticResource FontSizeCaption}"
                                       LetterSpacing="2" />
                            <TextBlock Text="{Binding SettingsPath}"
                                       FontFamily="Cascadia Mono, Consolas, monospace"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="FileCrypter keeps this file on your device only. The app does not store passwords or key files in settings."
                                       Foreground="{DynamicResource MutedForegroundBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Spacing="16">
                    <Border Classes="aurora-card">
                        <StackPanel Spacing="12">
                            <TextBlock Text="ABOUT"
                                       Foreground="{DynamicResource SectionLabelForegroundBrush}"
                                       FontSize="{StaticResource FontSizeCaption}"
                                       LetterSpacing="2" />
                            <TextBlock Text="{Binding CurrentVersion}"
                                       FontSize="{StaticResource FontSizePanelTitle}"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="Open the changelog when you want a quick recap of the latest desktop polish."
                                       Foreground="{DynamicResource MutedForegroundBrush}"
                                       TextWrapping="Wrap" />
                            <Button Classes="aurora-secondary"
                                    Content="{Binding ChangelogButtonText}"
                                    Command="{Binding ToggleChangelogCommand}"
                                    HorizontalAlignment="Left" />
                        </StackPanel>
                    </Border>

                    <Border Classes="aurora-card"
                            IsVisible="{Binding IsChangelogExpanded}">
                        <StackPanel Spacing="12">
                            <TextBlock Text="{Binding ChangelogHeading}"
                                       Foreground="{DynamicResource AccentForegroundBrush}"
                                       FontSize="{StaticResource FontSizeTitle}"
                                       FontWeight="SemiBold" />
                            <ItemsControl ItemsSource="{Binding ChangelogEntries}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:HelpTopicViewModel">
                                        <Border Classes="aurora-panel"
                                                Margin="0,0,0,10">
                                            <StackPanel Spacing="6">
                                                <TextBlock Text="{Binding Title}"
                                                           FontSize="{StaticResource FontSizeTitle}"
                                                           FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Description}"
                                                           Foreground="{DynamicResource MutedForegroundBrush}"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Classes="aurora-card">
                        <StackPanel Spacing="14">
                            <TextBlock Text="MAINTENANCE"
                                       Foreground="{DynamicResource SectionLabelForegroundBrush}"
                                       FontSize="{StaticResource FontSizeCaption}"
                                       LetterSpacing="2" />
                            <TextBlock Text="{Binding ProgressText}"
                                       Foreground="{DynamicResource MutedForegroundBrush}"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="Reload re-reads the local settings file. Reset restores FileCrypter's default behavior and saves it immediately."
                                       Foreground="{DynamicResource SectionLabelForegroundBrush}"
                                       TextWrapping="Wrap" />
                            <Grid ColumnDefinitions="*,*"
                                  ColumnSpacing="12">
                                <Button Classes="aurora-secondary"
                                        Content="Reload"
                                        Command="{Binding ReloadSettingsCommand}" />
                                <Button Grid.Column="1"
                                        Classes="aurora-secondary"
                                        Content="Reset to defaults"
                                        Command="{Binding ResetToDefaultsCommand}" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
