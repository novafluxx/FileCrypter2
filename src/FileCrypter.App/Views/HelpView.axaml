<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FileCrypter.App.ViewModels"
             x:Class="FileCrypter.App.Views.HelpView"
             x:DataType="vm:HelpViewModel">
    <ScrollViewer>
        <StackPanel Spacing="24" MaxWidth="1000">
            <Border Background="{DynamicResource WarningBackgroundBrush}"
                    BorderBrush="{DynamicResource WarningBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="24,18">
                <StackPanel Spacing="8">
                    <TextBlock Text="RECOVERY WARNING"
                               Foreground="{DynamicResource WarningAccentForegroundBrush}"
                               FontSize="15"
                               FontWeight="Bold"
                               LetterSpacing="2" />
                    <TextBlock Text="Keep the password and any key file together in a way you trust. FileCrypter cannot recover forgotten passwords or lost or changed key files."
                               Foreground="{DynamicResource WarningForegroundBrush}"
                               FontSize="18"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Background="{DynamicResource SurfaceBackgroundBrush}"
                    BorderBrush="{DynamicResource SurfaceBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="28">
                <StackPanel Spacing="16">
                    <TextBlock Text="WORKFLOW GUIDES"
                               Foreground="{DynamicResource SectionLabelForegroundBrush}"
                               FontSize="15"
                               FontWeight="Bold"
                               LetterSpacing="2" />
                    <ItemsControl ItemsSource="{Binding WorkflowTopics}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:HelpTopicViewModel">
                                <Border Background="{DynamicResource SurfaceAltBackgroundBrush}"
                                        BorderBrush="{DynamicResource SurfaceAltBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="18"
                                        Margin="0,0,0,12">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="{Binding Title}"
                                                   FontSize="18"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Description}"
                                                   Foreground="{DynamicResource MutedForegroundBrush}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Background="{DynamicResource SurfaceBackgroundBrush}"
                    BorderBrush="{DynamicResource SurfaceBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="28">
                <StackPanel Spacing="16">
                    <TextBlock Text="TROUBLESHOOTING"
                               Foreground="{DynamicResource SectionLabelForegroundBrush}"
                               FontSize="15"
                               FontWeight="Bold"
                               LetterSpacing="2" />
                    <ItemsControl ItemsSource="{Binding TroubleshootingTopics}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:HelpTopicViewModel">
                                <Border Background="{DynamicResource SurfaceAltBackgroundBrush}"
                                        BorderBrush="{DynamicResource SurfaceAltBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="18"
                                        Margin="0,0,0,12">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="{Binding Title}"
                                                   FontSize="18"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Description}"
                                                   Foreground="{DynamicResource MutedForegroundBrush}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Background="{DynamicResource SurfaceBackgroundBrush}"
                    BorderBrush="{DynamicResource SurfaceBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="28">
                <StackPanel Spacing="16">
                    <TextBlock Text="UPDATES AND COMPATIBILITY"
                               Foreground="{DynamicResource SectionLabelForegroundBrush}"
                               FontSize="15"
                               FontWeight="Bold"
                               LetterSpacing="2" />
                    <TextBlock Text="{Binding CurrentVersion}"
                               FontSize="24"
                               FontWeight="SemiBold" />
                    <TextBlock Text="{Binding FormatVersionText}"
                               Foreground="{DynamicResource AccentForegroundBrush}"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{Binding UpdateSummaryText}"
                               Foreground="{Binding UpdateSummaryBrush}"
                               FontSize="18"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{Binding UpdateDetailText}"
                               Foreground="{DynamicResource MutedForegroundBrush}"
                               TextWrapping="Wrap" />
                    <TextBlock IsVisible="{Binding HasLastCheckedText}"
                               Text="{Binding LastCheckedText}"
                               Foreground="{DynamicResource SectionLabelForegroundBrush}"
                               TextWrapping="Wrap" />
                    <Button Content="Check for updates"
                            Command="{Binding CheckForUpdatesCommand}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            FontSize="18"
                            FontWeight="SemiBold" />
                    <TextBlock Text="Automatic install and relaunch are still pending. This help page keeps the user-facing update state visible while the fuller desktop update flow is still on the roadmap."
                               Foreground="{DynamicResource SectionLabelForegroundBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Background="{DynamicResource SurfaceBackgroundBrush}"
                    BorderBrush="{DynamicResource SurfaceBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="28">
                <StackPanel Spacing="16">
                    <TextBlock Text="SAFETY AND PRIVACY"
                               Foreground="{DynamicResource SectionLabelForegroundBrush}"
                               FontSize="15"
                               FontWeight="Bold"
                               LetterSpacing="2" />
                    <ItemsControl ItemsSource="{Binding SafetyTopics}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:HelpTopicViewModel">
                                <Border Background="{DynamicResource SurfaceAltBackgroundBrush}"
                                        BorderBrush="{DynamicResource SurfaceAltBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="18"
                                        Margin="0,0,0,12">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="{Binding Title}"
                                                   FontSize="18"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Description}"
                                                   Foreground="{DynamicResource MutedForegroundBrush}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
