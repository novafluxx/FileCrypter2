<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FileCrypter.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="760"
        x:Class="FileCrypter.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="FileCrypter"
        Width="1180"
        Height="760"
        MinWidth="860"
        MinHeight="600">

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Grid Background="#101111" ColumnDefinitions="288,*" RowDefinitions="*,56">
        <Border Grid.RowSpan="2"
                BorderBrush="#363838"
                BorderThickness="0,0,1,0"
                Background="#202222">
            <Grid RowDefinitions="136,*,Auto">
                <StackPanel Margin="28,30,28,0">
                    <TextBlock Text="FileCrypter"
                               FontSize="24"
                               FontWeight="SemiBold" />
                    <TextBlock Text="{Binding AppVersion}"
                               FontSize="17"
                               Foreground="#a9aaa7"
                               Margin="0,8,0,0" />
                </StackPanel>

                <StackPanel Grid.Row="1">
                    <ItemsControl ItemsSource="{Binding PrimaryNavigationItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:NavigationItemViewModel">
                                <ToggleButton Classes="nav-item"
                                              Content="{Binding Title}"
                                              IsChecked="{Binding IsSelected}"
                                              Command="{Binding SelectCommand}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <StackPanel Grid.Row="2" Margin="0,0,0,28">
                    <ItemsControl ItemsSource="{Binding SecondaryNavigationItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:NavigationItemViewModel">
                                <ToggleButton Classes="nav-item"
                                              Content="{Binding Title}"
                                              IsChecked="{Binding IsSelected}"
                                              Command="{Binding SelectCommand}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1" RowDefinitions="88,*">
            <Border BorderBrush="#363838"
                    BorderThickness="0,0,0,1"
                    Background="#242626">
                <Grid ColumnDefinitions="*,Auto" Margin="32,0">
                    <TextBlock Text="{Binding CurrentPageTitle}"
                               VerticalAlignment="Center"
                               FontSize="26"
                               FontWeight="SemiBold" />
                    <TextBlock Grid.Column="1"
                               Text="Changelog"
                               VerticalAlignment="Center"
                               Foreground="#9cc4ff"
                               FontSize="18" />
                </Grid>
            </Border>

            <ContentControl Grid.Row="1"
                            Content="{Binding CurrentPage}"
                            Margin="32" />
        </Grid>

        <Border Grid.Column="1"
                Grid.Row="1"
                BorderBrush="#363838"
                BorderThickness="0,1,0,0"
                Background="#242626">
            <Grid ColumnDefinitions="*,Auto" Margin="32,0">
                <TextBlock Text="{Binding StatusText}"
                           VerticalAlignment="Center"
                           Foreground="#b8b9b5" />
                <TextBlock Grid.Column="1"
                           Text="{Binding FooterDetail}"
                           VerticalAlignment="Center"
                           Foreground="#b8b9b5" />
            </Grid>
        </Border>
    </Grid>

</Window>
