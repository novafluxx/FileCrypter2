<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FileCrypter.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="760"
        x:Class="FileCrypter.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/FileCrypter.ico"
        Title="FileCrypter"
        Width="1280"
        Height="820"
        MinWidth="980"
        MinHeight="680">

    <Window.Resources>
        <DataTemplate x:Key="NavigationItemContentTemplate" x:DataType="vm:NavigationItemViewModel">
            <StackPanel Orientation="Horizontal"
                        Spacing="12"
                        VerticalAlignment="Center">
                <Viewbox Width="18"
                         Height="18"
                         Stretch="Uniform">
                    <Path Classes="nav-item-icon"
                          Data="{Binding IconPathData}"
                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
                </Viewbox>
                <TextBlock Text="{Binding Title}"
                           Classes="nav-item-label"
                           VerticalAlignment="Center"
                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Grid x:Name="RootLayout"
          ClipToBounds="True"
          Classes.sidebar-collapsed="{Binding IsSidebarCollapsed}"
          Background="{DynamicResource WindowBackgroundBrush}"
          RowDefinitions="*,58">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="248"
                              MinWidth="72"
                              MaxWidth="248" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border x:Name="SidebarShell"
                Classes="sidebar-shell"
                Grid.RowSpan="2"
                Background="{DynamicResource SidebarBackgroundBrush}"
                BorderBrush="{DynamicResource SidebarBorderBrush}"
                BorderThickness="0,0,1,0"
                Padding="18,18,18,20">
            <Grid RowDefinitions="Auto,Auto,*,Auto">
                <Border Classes="aurora-card app-brand"
                        IsVisible="{Binding IsSidebarExpanded}"
                        Padding="16"
                        CornerRadius="18">
                    <Grid ColumnDefinitions="Auto,*,Auto"
                          ColumnSpacing="12">
                        <Border Width="46"
                                Height="46"
                                CornerRadius="14"
                                ClipToBounds="True">
                            <Image Source="/Assets/FileCrypter.png"
                                   Width="46"
                                   Height="46"
                                   Stretch="UniformToFill" />
                        </Border>
                        <StackPanel Grid.Column="1"
                                    IsVisible="{Binding IsSidebarExpanded}"
                                    VerticalAlignment="Center"
                                    Spacing="2">
                            <TextBlock Text="FileCrypter"
                                       FontSize="{StaticResource FontSizeAppTitle}"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="{Binding AppVersion}"
                                       FontSize="{StaticResource FontSizeAppMeta}"
                                       Foreground="{DynamicResource SidebarDetailForegroundBrush}" />
                        </StackPanel>
                        <Button Grid.Column="2"
                                Classes="sidebar-toggle"
                                Command="{Binding ToggleSidebarCommand}"
                                ToolTip.Tip="{Binding SidebarToggleToolTip}">
                            <Viewbox Width="18"
                                     Height="18"
                                     Stretch="Uniform">
                                <Path Classes="nav-item-icon"
                                      Data="M4 5.25C4 4.83579 4.33579 4.5 4.75 4.5H19.25C19.6642 4.5 20 4.83579 20 5.25C20 5.66421 19.6642 6 19.25 6H4.75C4.33579 6 4 5.66421 4 5.25ZM4 12C4 11.5858 4.33579 11.25 4.75 11.25H19.25C19.6642 11.25 20 11.5858 20 12C20 12.4142 19.6642 12.75 19.25 12.75H4.75C4.33579 12.75 4 12.4142 4 12ZM4.75 18C4.33579 18 4 18.3358 4 18.75C4 19.1642 4.33579 19.5 4.75 19.5H19.25C19.6642 19.5 20 19.1642 20 18.75C20 18.3358 19.6642 18 19.25 18H4.75Z"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            </Viewbox>
                        </Button>
                    </Grid>
                </Border>

                <StackPanel Classes="collapsed-brand"
                            IsVisible="{Binding IsSidebarCollapsed}"
                            Spacing="10"
                            HorizontalAlignment="Center">
                    <Border Width="46"
                            Height="46"
                            CornerRadius="14"
                            ClipToBounds="True"
                            ToolTip.Tip="FileCrypter">
                        <Image Source="/Assets/FileCrypter.png"
                               Width="46"
                               Height="46"
                               Stretch="UniformToFill" />
                    </Border>
                    <Button Classes="sidebar-toggle"
                            Command="{Binding ToggleSidebarCommand}"
                            ToolTip.Tip="{Binding SidebarToggleToolTip}">
                        <Viewbox Width="18"
                                 Height="18"
                                 Stretch="Uniform">
                            <Path Classes="nav-item-icon"
                                  Data="M4 5.25C4 4.83579 4.33579 4.5 4.75 4.5H19.25C19.6642 4.5 20 4.83579 20 5.25C20 5.66421 19.6642 6 19.25 6H4.75C4.33579 6 4 5.66421 4 5.25ZM4 12C4 11.5858 4.33579 11.25 4.75 11.25H19.25C19.6642 11.25 20 11.5858 20 12C20 12.4142 19.6642 12.75 19.25 12.75H4.75C4.33579 12.75 4 12.4142 4 12ZM4.75 18C4.33579 18 4 18.3358 4 18.75C4 19.1642 4.33579 19.5 4.75 19.5H19.25C19.6642 19.5 20 19.1642 20 18.75C20 18.3358 19.6642 18 19.25 18H4.75Z"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Viewbox>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Row="1"
                            Classes="sidebar-nav-primary"
                            Margin="6,26,6,0"
                            Spacing="8">
                    <TextBlock Text="WORKFLOWS"
                               Classes="sidebar-expanded-only"
                               FontSize="{StaticResource FontSizeCaption}"
                               LetterSpacing="2"
                               Foreground="{DynamicResource SectionLabelForegroundBrush}" />
                    <ItemsControl ItemsSource="{Binding PrimaryNavigationItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:NavigationItemViewModel">
                                <ToggleButton Classes="nav-item"
                                              Content="{Binding}"
                                              ContentTemplate="{StaticResource NavigationItemContentTemplate}"
                                              IsChecked="{Binding IsSelected}"
                                              Command="{Binding SelectCommand}"
                                              ToolTip.Tip="{Binding Title}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <Border Grid.Row="2"
                        Classes="sidebar-divider"
                        Margin="10,26,10,18"
                        Background="#0DFFFFFF"
                        CornerRadius="1"
                        Height="1"
                        VerticalAlignment="Top" />

                <StackPanel Grid.Row="3"
                            Classes="sidebar-nav-secondary"
                            Margin="6,0,6,0"
                            Spacing="8">
                    <TextBlock Text="SYSTEM"
                               Classes="sidebar-expanded-only"
                               FontSize="{StaticResource FontSizeCaption}"
                               LetterSpacing="2"
                               Foreground="{DynamicResource SectionLabelForegroundBrush}" />
                    <ItemsControl ItemsSource="{Binding SecondaryNavigationItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:NavigationItemViewModel">
                                <ToggleButton Classes="nav-item"
                                              Content="{Binding}"
                                              ContentTemplate="{StaticResource NavigationItemContentTemplate}"
                                              IsChecked="{Binding IsSelected}"
                                              Command="{Binding SelectCommand}"
                                              ToolTip.Tip="{Binding Title}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Grid>
        </Border>

        <ContentControl Grid.Column="1"
                        Grid.Row="0"
                        Content="{Binding CurrentPage}"
                        Margin="0" />

        <Border Grid.Column="1"
                Grid.Row="0"
                Classes="workflow-toast"
                Classes.warning="{Binding IsToastWarning}"
                Classes.success="{Binding IsToastSuccess}"
                IsVisible="{Binding IsToastVisible}"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0,0,28,24">
            <Grid ColumnDefinitions="*,Auto"
                  ColumnSpacing="14"
                  MaxWidth="460">
                <StackPanel Spacing="4">
                    <TextBlock Text="{Binding ToastTitle}"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{Binding ToastMessage}"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{Binding ToastDetail}"
                               IsVisible="{Binding HasToastDetail}"
                               Classes="workflow-toast-detail"
                               TextWrapping="Wrap" />
                </StackPanel>
                <Button Grid.Column="1"
                        Classes="workflow-toast-dismiss"
                        Content="x"
                        Command="{Binding DismissToastCommand}"
                        ToolTip.Tip="Dismiss notification" />
            </Grid>
        </Border>

        <Border Grid.Column="1"
                Grid.Row="1"
                Background="{DynamicResource WindowTopChromeBrush}"
                BorderBrush="{DynamicResource SidebarBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="28,0">
            <Grid ColumnDefinitions="*,Auto"
                  VerticalAlignment="Center">
                <TextBlock Text="{Binding StatusText}"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource MutedForegroundBrush}" />
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="8"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <TextBlock Text="{Binding FooterDetail}"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource SectionLabelForegroundBrush}"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="360" />
                    <Button Classes="status-link"
                            Command="{Binding FooterActionCommand}"
                            IsVisible="{Binding HasFooterAction}"
                            ToolTip.Tip="{Binding FooterActionText}">
                        <TextBlock Text="{Binding FooterActionText}"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="420" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>

</Window>
