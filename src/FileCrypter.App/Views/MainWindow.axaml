<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FileCrypter.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="760"
        x:Class="FileCrypter.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="FileCrypter"
        Width="1180"
        Height="760"
        MinWidth="860"
        MinHeight="600">

    <Window.Resources>
        <DataTemplate x:Key="NavigationItemContentTemplate" x:DataType="vm:NavigationItemViewModel">
            <StackPanel Orientation="Horizontal"
                        Spacing="12"
                        VerticalAlignment="Center">
                <Viewbox Width="18"
                         Height="18"
                         Stretch="Uniform">
                    <Path Classes="nav-item-icon"
      Data="{Binding IconPathData}"
      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
      StrokeThickness="1.5"
      StrokeLineCap="Round"
      StrokeJoin="Round"
      Fill="Transparent" />
                </Viewbox>
                <TextBlock Text="{Binding Title}"
                           VerticalAlignment="Center"
                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Grid Background="{DynamicResource WindowBackgroundBrush}" ColumnDefinitions="200,*" RowDefinitions="*,56">
        <Border Grid.RowSpan="2"
                BorderBrush="{DynamicResource SidebarBorderBrush}"
                BorderThickness="0,0,1,0"
                Background="{DynamicResource SidebarBackgroundBrush}">
            <Grid RowDefinitions="136,*,Auto">
                <StackPanel Margin="28,30,28,0">
                    <TextBlock Text="FileCrypter"
                               FontSize="{StaticResource FontSizeAppTitle}"
                               FontWeight="SemiBold" />
                    <TextBlock Text="{Binding AppVersion}"
                               FontSize="{StaticResource FontSizeAppMeta}"
                               Foreground="{DynamicResource SidebarDetailForegroundBrush}"
                               Margin="0,8,0,0" />
                </StackPanel>

                <StackPanel Grid.Row="1">
                    <ItemsControl ItemsSource="{Binding PrimaryNavigationItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:NavigationItemViewModel">
                                <ToggleButton Classes="nav-item"
                                              Content="{Binding}"
                                              ContentTemplate="{StaticResource NavigationItemContentTemplate}"
                                              IsChecked="{Binding IsSelected}"
                                              Command="{Binding SelectCommand}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <StackPanel Grid.Row="2" Margin="0,0,0,28">
                    <ItemsControl ItemsSource="{Binding SecondaryNavigationItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:NavigationItemViewModel">
                                <ToggleButton Classes="nav-item"
                                              Content="{Binding}"
                                              ContentTemplate="{StaticResource NavigationItemContentTemplate}"
                                              IsChecked="{Binding IsSelected}"
                                              Command="{Binding SelectCommand}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1" RowDefinitions="88,*">
            <Border BorderBrush="{DynamicResource SidebarBorderBrush}"
                    BorderThickness="0,0,0,1"
                    Background="{DynamicResource SurfaceBackgroundBrush}">
                <Grid Margin="32,0">
                    <TextBlock Text="{Binding CurrentPageTitle}"
                               VerticalAlignment="Center"
                               FontSize="{StaticResource FontSizePageTitle}"
                               FontWeight="SemiBold" />
                </Grid>
            </Border>

            <ContentControl Grid.Row="1"
                            Content="{Binding CurrentPage}"
                            Margin="32" />
        </Grid>

        <Border Grid.Column="1"
                Grid.Row="1"
                BorderBrush="{DynamicResource SidebarBorderBrush}"
                BorderThickness="0,1,0,0"
                Background="{DynamicResource SurfaceBackgroundBrush}">
            <Grid ColumnDefinitions="*,Auto" Margin="32,0">
                <TextBlock Text="{Binding StatusText}"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource MutedForegroundBrush}" />
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="6"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <TextBlock Text="{Binding FooterDetail}"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource MutedForegroundBrush}"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="380" />
                    <Button Classes="status-link"
                            Command="{Binding FooterActionCommand}"
                            IsVisible="{Binding HasFooterAction}"
                            ToolTip.Tip="{Binding FooterActionText}">
                        <TextBlock Text="{Binding FooterActionText}"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="420" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>

</Window>
