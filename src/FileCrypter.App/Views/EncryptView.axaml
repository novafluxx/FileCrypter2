<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FileCrypter.App.ViewModels"
             x:Class="FileCrypter.App.Views.EncryptView"
             x:DataType="vm:EncryptViewModel">
    <ScrollViewer>
        <StackPanel Spacing="24" MaxWidth="1000">
            <Border IsVisible="{Binding HasError}"
                    Background="{DynamicResource ErrorBackgroundBrush}"
                    BorderBrush="{DynamicResource ErrorBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="24,18">
                <StackPanel Spacing="12">
                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="{DynamicResource ErrorForegroundBrush}"
                               FontSize="18"
                               TextWrapping="Wrap" />
                    <Button Content="Copy issue"
                            Command="{Binding CopyErrorCommand}"
                            HorizontalAlignment="Left" />
                </StackPanel>
            </Border>

            <Border Background="{DynamicResource SurfaceBackgroundBrush}"
                    BorderBrush="{DynamicResource SurfaceBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="28"
                    x:Name="SourceDropZone">
                <StackPanel Spacing="14">
                    <TextBlock Text="SOURCE FILE"
                               Foreground="{DynamicResource SectionLabelForegroundBrush}"
                               FontSize="15"
                               FontWeight="Bold"
                               LetterSpacing="2" />
                    <Grid ColumnDefinitions="*,160" ColumnSpacing="16">
                        <TextBox Text="{Binding SourcePath}"
                                 PlaceholderText="Select or drag a file..."
                                 FontSize="20" />
                        <Button Grid.Column="1"
                                Content="Browse"
                                Command="{Binding BrowseSourceCommand}" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Background="{DynamicResource SurfaceBackgroundBrush}"
                    BorderBrush="{DynamicResource SurfaceBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="28">
                <StackPanel Spacing="14">
                    <TextBlock Text="OUTPUT FILE"
                               Foreground="{DynamicResource SectionLabelForegroundBrush}"
                               FontSize="15"
                               FontWeight="Bold"
                               LetterSpacing="2" />
                    <Grid ColumnDefinitions="*,160" ColumnSpacing="16">
                        <TextBox Text="{Binding OutputPath}"
                                 PlaceholderText="Auto-generated from input filename..."
                                 FontSize="20" />
                        <Button Grid.Column="1"
                                Content="Browse"
                                Command="{Binding BrowseOutputCommand}" />
                    </Grid>

                    <CheckBox IsChecked="{Binding NeverOverwriteExistingFiles}"
                              Content="Never overwrite existing files" />
                    <TextBlock Text="Saves as &quot;name (1)&quot; if the output already exists."
                               Foreground="{DynamicResource SectionLabelForegroundBrush}"
                               Margin="32,0,0,0" />

                    <CheckBox IsChecked="{Binding EnableCompression}"
                              Content="Enable compression (ZSTD)" />
                    <TextBlock Text="Compresses before encrypting. Best for text and documents."
                               Foreground="{DynamicResource SectionLabelForegroundBrush}"
                               Margin="32,0,0,0" />
                </StackPanel>
            </Border>

            <Border Background="{DynamicResource SurfaceBackgroundBrush}"
                    BorderBrush="{DynamicResource SurfaceBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="28">
                <StackPanel Spacing="14">
                    <TextBlock Text="PASSWORD AND KEY FILE"
                               Foreground="{DynamicResource SectionLabelForegroundBrush}"
                               FontSize="15"
                               FontWeight="Bold"
                               LetterSpacing="2" />
                    <TextBox Text="{Binding Password}"
                             PasswordChar="*"
                             PlaceholderText="Password"
                             FontSize="20" />

                    <TextBlock Text="Choose one optional key-file mode: reuse an existing key file or generate a new one for this file."
                               Foreground="{DynamicResource MutedForegroundBrush}"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{Binding KeyFileChoiceStatusText}"
                               Foreground="{DynamicResource AccentForegroundBrush}"
                               TextWrapping="Wrap" />

                    <Grid ColumnDefinitions="*,140,96" ColumnSpacing="16">
                        <TextBox Text="{Binding KeyFilePath}"
                                 IsEnabled="{Binding CanEditExistingKeyFileChoice}"
                                 PlaceholderText="Optional existing key file..."
                                 FontSize="18" />
                        <Button Grid.Column="1"
                                Content="Browse"
                                Command="{Binding BrowseKeyFileCommand}" />
                        <Button Grid.Column="2"
                                Content="Clear"
                                Command="{Binding ClearKeyFileCommand}" />
                    </Grid>
                    <TextBlock Text="Use a key file you already have. The same unchanged file is required to decrypt later."
                               Foreground="{DynamicResource SectionLabelForegroundBrush}"
                               Margin="32,0,0,0"
                               TextWrapping="Wrap" />

                    <Grid ColumnDefinitions="*,140,96" ColumnSpacing="16">
                        <TextBox Text="{Binding GenerateKeyFilePath}"
                                 IsEnabled="{Binding CanEditGeneratedKeyFileChoice}"
                                 PlaceholderText="Optional new key file path..."
                                 FontSize="18" />
                        <Button Grid.Column="1"
                                Content="Browse"
                                Command="{Binding BrowseGeneratedKeyFileCommand}" />
                        <Button Grid.Column="2"
                                Content="Clear"
                                Command="{Binding ClearGeneratedKeyFileCommand}" />
                    </Grid>
                    <TextBlock Text="Generate a fresh key file for this run. Keep that new file safe and unchanged."
                               Foreground="{DynamicResource SectionLabelForegroundBrush}"
                               Margin="32,0,0,0"
                               TextWrapping="Wrap" />

                    <TextBlock Text="If a key file is used, keep it unchanged. Losing it makes the encrypted file unrecoverable."
                               Foreground="{DynamicResource SectionLabelForegroundBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Background="{DynamicResource SurfaceBackgroundBrush}"
                    BorderBrush="{DynamicResource SurfaceBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="28">
                <StackPanel Spacing="16">
                    <ProgressBar Minimum="0"
                                 Maximum="100"
                                 Value="{Binding ProgressPercent}" />
                    <TextBlock Text="{Binding ProgressText}"
                               Foreground="{DynamicResource MutedForegroundBrush}" />
                    <Button Content="Encrypt file"
                            Command="{Binding StartEncryptCommand}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            FontSize="18"
                            FontWeight="SemiBold" />
                </StackPanel>
            </Border>

            <Border IsVisible="{Binding HasResult}"
                    Background="{DynamicResource SuccessBackgroundBrush}"
                    BorderBrush="{DynamicResource SuccessBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="24,18">
                <StackPanel Spacing="10">
                    <TextBlock Text="Encryption complete."
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource SuccessAccentForegroundBrush}" />
                    <TextBlock Text="{Binding ResultPath}"
                               Foreground="{DynamicResource SuccessForegroundBrush}"
                               TextWrapping="Wrap" />
                    <TextBlock IsVisible="{Binding HasGeneratedKeyFileResult}"
                               Text="Generated key file:"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource SuccessAccentForegroundBrush}" />
                    <TextBlock IsVisible="{Binding HasGeneratedKeyFileResult}"
                               Text="{Binding GeneratedKeyFileResultPath}"
                               Foreground="{DynamicResource SuccessForegroundBrush}"
                               TextWrapping="Wrap" />
                    <Button Content="Copy result"
                            Command="{Binding CopyResultCommand}"
                            HorizontalAlignment="Left" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
