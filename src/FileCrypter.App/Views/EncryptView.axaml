<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FileCrypter.App.ViewModels"
             x:Class="FileCrypter.App.Views.EncryptView"
             x:DataType="vm:EncryptViewModel">
    <ScrollViewer>
        <StackPanel Margin="36,30,36,36"
                    Spacing="24"
                    MaxWidth="1220">
            <Border IsVisible="{Binding HasError}"
                    Background="{DynamicResource ErrorBackgroundBrush}"
                    BorderBrush="{DynamicResource ErrorBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="18"
                    Padding="18,16">
                <Grid ColumnDefinitions="*,Auto"
                      ColumnSpacing="16">
                    <TextBlock Text="{Binding VisibleErrorMessage}"
                               Foreground="{DynamicResource ErrorForegroundBrush}"
                               FontSize="{StaticResource FontSizeTitle}"
                               TextWrapping="Wrap" />
                    <Button Grid.Column="1"
                            Classes="aurora-secondary"
                            Content="Copy issue"
                            Command="{Binding CopyErrorCommand}"
                            VerticalAlignment="Center" />
                </Grid>
            </Border>

            <Grid ColumnDefinitions="*,360"
                  ColumnSpacing="20"
                  RowDefinitions="Auto,*">
                <StackPanel Grid.ColumnSpan="2"
                            Spacing="10">
                    <Border Classes="aurora-panel hero-badge"
                            HorizontalAlignment="Left"
                            Margin="0,0,0,14">
                        <TextBlock Classes="hero-badge-text"
                                   Text="{Binding HeroTitle}"
                                   Foreground="{DynamicResource AccentForegroundBrush}"
                                   TextWrapping="Wrap" />
                    </Border>
                </StackPanel>

                <StackPanel Grid.Row="1"
                            Spacing="18">
                    <Border Classes="aurora-card"
                            x:Name="SourceDropZone">
                        <Border Classes="file-drop-zone">
                            <Grid>
                                <StackPanel IsVisible="{Binding ShowEmptySourceState}"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Spacing="10">
                                    <Border Width="82"
                                            Height="82"
                                            CornerRadius="24"
                                            Background="{DynamicResource NavigationSelectedBackgroundBrush}"
                                            BorderBrush="{DynamicResource SurfaceBorderBrush}"
                                            BorderThickness="1">
                                        <Viewbox Width="30"
                                                 Height="30"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center">
                                            <Path Classes="file-preview-icon"
                                                  Data="M21 15 V19 C21 20.1 20.1 21 19 21 H5 C3.9 21 3 20.1 3 19 V15 M17 8 L12 3 L7 8 M12 3 V16" />
                                        </Viewbox>
                                    </Border>
                                    <TextBlock Text="Drop a file here"
                                               FontSize="18"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center" />
                                    <TextBlock Text="Click to browse or drag a local file into the vault."
                                               Foreground="{DynamicResource MutedForegroundBrush}"
                                               HorizontalAlignment="Center"
                                               TextWrapping="Wrap" />
                                </StackPanel>

                                <Border IsVisible="{Binding HasSelectedFile}"
                                        Classes="file-preview-row"
                                        VerticalAlignment="Center">
                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto"
                                          ColumnSpacing="16"
                                          VerticalAlignment="Center">
                                        <Border Width="56"
                                                Height="66"
                                                CornerRadius="14"
                                                Background="{DynamicResource NavigationSelectedBackgroundBrush}"
                                                BorderBrush="{DynamicResource SurfaceBorderBrush}"
                                                BorderThickness="1">
                                            <Viewbox Width="24"
                                                     Height="24"
                                                     HorizontalAlignment="Center"
                                                     VerticalAlignment="Center">
                                                <Path Classes="file-preview-icon"
                                                      Data="{Binding SourcePreview.IconPathData}" />
                                            </Viewbox>
                                        </Border>
                                        <StackPanel Grid.Column="1"
                                                    Spacing="4"
                                                    VerticalAlignment="Center">
                                            <TextBlock Text="{Binding SourcePreview.DisplayName}"
                                                       ToolTip.Tip="{Binding SourcePreview.FullPath}"
                                                       FontSize="{StaticResource FontSizeTitle}"
                                                       FontWeight="SemiBold"
                                                       TextWrapping="NoWrap"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding SourcePreview.SizeText}"
                                                       Foreground="{DynamicResource SectionLabelForegroundBrush}" />
                                            <TextBlock Text="{Binding OutputDisplayText}"
                                                       Foreground="{DynamicResource AccentSecondaryForegroundBrush}"
                                                       FontSize="{StaticResource FontSizeCaption}"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2"
                                                   Text="LOCAL"
                                                   Foreground="{DynamicResource SectionLabelForegroundBrush}"
                                                   VerticalAlignment="Center"
                                                   FontSize="{StaticResource FontSizeCaption}"
                                                   LetterSpacing="2" />
                                        <Button Grid.Column="3"
                                                Classes="file-preview-remove"
                                                Content="x"
                                                Command="{Binding ClearSourceCommand}"
                                                ToolTip.Tip="Clear selected file" />
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                    </Border>

                    <Border Classes="aurora-card">
                        <StackPanel Spacing="14">
                            <StackPanel Spacing="4">
                                <TextBlock Text="PASSPHRASE"
                                           Foreground="{DynamicResource SectionLabelForegroundBrush}"
                                           FontSize="{StaticResource FontSizeCaption}"
                                           LetterSpacing="2" />
                                <TextBlock Text="Use something memorable but uncommon."
                                           Foreground="{DynamicResource MutedForegroundBrush}" />
                            </StackPanel>

                            <Grid ColumnDefinitions="*,Auto,Auto"
                                  ColumnSpacing="10">
                                <TextBox Text="{Binding Password}"
                                         PasswordChar="*"
                                         PlaceholderText="Enter a passphrase"
                                         IsVisible="{Binding ShowMaskedPasswordInput}" />
                                <TextBox Text="{Binding Password}"
                                         PlaceholderText="Enter a passphrase"
                                         IsVisible="{Binding ShowPassword}" />
                                <Button Grid.Column="1"
                                        Classes="aurora-secondary"
                                        Content="Generate">
                                    <Button.Flyout>
                                        <MenuFlyout>
                                            <MenuItem Header="Random password"
                                                      Command="{Binding GenerateRandomPasswordCommand}" />
                                            <MenuItem Header="Memorable passphrase"
                                                      Command="{Binding GenerateMemorablePassphraseCommand}" />
                                        </MenuFlyout>
                                    </Button.Flyout>
                                </Button>
                                <Button Grid.Column="2"
                                        Classes="aurora-secondary"
                                        Content="{Binding PasswordVisibilityActionText}"
                                        Command="{Binding TogglePasswordVisibilityCommand}" />
                            </Grid>

                            <StackPanel Spacing="6">
                                <ProgressBar Classes="aurora-progress"
                                             Minimum="0"
                                             Maximum="100"
                                             Value="{Binding PasswordStrengthPercent}" />
                                <Grid ColumnDefinitions="*,Auto"
                                      ColumnSpacing="12">
                                    <TextBlock Text="{Binding PasswordStrengthLabel}"
                                               Foreground="{DynamicResource SectionLabelForegroundBrush}" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding PasswordStrengthDetail}"
                                               Foreground="{DynamicResource SectionLabelForegroundBrush}"
                                               FontFamily="Cascadia Mono, Consolas, monospace" />
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Classes="aurora-card"
                            IsVisible="{Binding IsAdvancedOptionsExpanded}">
                        <StackPanel Spacing="16">
                            <TextBlock Text="Advanced Options"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="Output path, overwrite protection, compression, and optional key-file modes."
                                       Foreground="{DynamicResource MutedForegroundBrush}"
                                       TextWrapping="Wrap" />

                            <StackPanel Spacing="8">
                                <TextBlock Text="OUTPUT FILE"
                                           Foreground="{DynamicResource SectionLabelForegroundBrush}"
                                           FontSize="{StaticResource FontSizeCaption}"
                                           LetterSpacing="2" />
                                <Grid ColumnDefinitions="*,150"
                                      ColumnSpacing="12">
                                    <TextBox Text="{Binding OutputPath}"
                                             PlaceholderText="Auto-generated from input filename..." />
                                    <Button Grid.Column="1"
                                            Classes="aurora-secondary"
                                            Content="Browse"
                                            Command="{Binding BrowseOutputCommand}" />
                                </Grid>
                            </StackPanel>

                            <CheckBox IsChecked="{Binding NeverOverwriteExistingFiles}"
                                      Content="Never overwrite existing files" />

                            <CheckBox IsChecked="{Binding EnableCompression}"
                                      Content="Enable compression (ZSTD)" />

                            <TextBlock Text="{Binding KeyFileChoiceStatusText}"
                                       Foreground="{DynamicResource AccentForegroundBrush}"
                                       TextWrapping="Wrap" />

                            <Grid ColumnDefinitions="*,120"
                                  ColumnSpacing="10">
                                <TextBox Text="{Binding KeyFilePath}"
                                         IsEnabled="{Binding CanEditExistingKeyFileChoice}"
                                         PlaceholderText="Optional existing key file..." />
                                <Button Grid.Column="1"
                                        Classes="aurora-secondary"
                                        Content="Browse"
                                        Command="{Binding BrowseKeyFileCommand}" />
                            </Grid>
                            <TextBlock Text="Use a key file you already have. The exact same unchanged file is required to decrypt later."
                                       Foreground="{DynamicResource SectionLabelForegroundBrush}"
                                       Margin="30,0,0,0"
                                       TextWrapping="Wrap" />

                            <Grid ColumnDefinitions="*,120"
                                  ColumnSpacing="10">
                                <TextBox Text="{Binding GenerateKeyFilePath}"
                                         IsEnabled="{Binding CanEditGeneratedKeyFileChoice}"
                                         PlaceholderText="Optional new key file path..." />
                                <Button Grid.Column="1"
                                        Classes="aurora-secondary"
                                        Content="Browse"
                                        Command="{Binding BrowseGeneratedKeyFileCommand}" />
                            </Grid>
                            <TextBlock Text="Generate a fresh key file for this run if you want a second factor you can store separately."
                                       Foreground="{DynamicResource SectionLabelForegroundBrush}"
                                       Margin="30,0,0,0"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                </StackPanel>

                <StackPanel Grid.Column="1"
                            Grid.Row="1"
                            Spacing="16">
                    <Border Classes="aurora-card">
                        <StackPanel Spacing="10">
                            <TextBlock Text="{Binding FilePreviewPanelTitle}"
                                       Foreground="{DynamicResource SectionLabelForegroundBrush}"
                                       FontSize="{StaticResource FontSizeCaption}"
                                       LetterSpacing="2" />
                            <TextBlock Text="{Binding FilePreviewPanelBody}"
                                       FontFamily="Cascadia Mono, Consolas, monospace"
                                       Foreground="{DynamicResource AccentForegroundBrush}"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="Passwords, key files, and plaintext stay on this device."
                                       Foreground="{DynamicResource MutedForegroundBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border Classes="aurora-card"
                            Padding="0">
                        <StackPanel>
                            <Grid Margin="24,18,24,18"
                                  ColumnDefinitions="*,Auto"
                                  ColumnSpacing="12">
                                <StackPanel Spacing="3">
                                    <TextBlock Text="Advanced Options"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="Output path, overwrite protection, compression, and optional key-file modes."
                                               Foreground="{DynamicResource MutedForegroundBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Classes="aurora-secondary"
                                        Content="Toggle"
                                        Command="{Binding ToggleAdvancedOptionsCommand}"
                                        VerticalAlignment="Center" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Classes="aurora-card"
                            IsVisible="{Binding IsRunning}">
                        <StackPanel Spacing="12">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="Sealing"
                                           FontWeight="SemiBold" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding ProgressPercent, StringFormat={}{0:0}%}"
                                           Foreground="{DynamicResource AccentSecondaryForegroundBrush}"
                                           FontFamily="Cascadia Mono, Consolas, monospace" />
                            </Grid>
                            <ProgressBar Minimum="0"
                                         Maximum="100"
                                         Value="{Binding ProgressPercent}" />
                            <TextBlock Text="{Binding ProgressText}"
                                       Foreground="{DynamicResource MutedForegroundBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border Classes="aurora-card"
                            IsVisible="{Binding HasResult}"
                            Background="{DynamicResource SuccessBackgroundBrush}"
                            BorderBrush="{DynamicResource SuccessBorderBrush}">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Encryption complete"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource SuccessAccentForegroundBrush}" />
                            <TextBlock Text="{Binding ResultPath}"
                                       Foreground="{DynamicResource SuccessForegroundBrush}"
                                       TextWrapping="Wrap" />
                            <TextBlock IsVisible="{Binding HasGeneratedKeyFileResult}"
                                       Text="Generated key file"
                                       Foreground="{DynamicResource SuccessAccentForegroundBrush}"
                                       FontWeight="SemiBold" />
                            <TextBlock IsVisible="{Binding HasGeneratedKeyFileResult}"
                                       Text="{Binding GeneratedKeyFileResultPath}"
                                       Foreground="{DynamicResource SuccessForegroundBrush}"
                                       TextWrapping="Wrap" />
                            <Button Classes="aurora-secondary"
                                    Content="Copy result"
                                    Command="{Binding CopyResultCommand}"
                                    HorizontalAlignment="Left" />
                        </StackPanel>
                    </Border>

                    <Border Classes="aurora-card"
                            IsVisible="{Binding ShowReadyAction}"
                            Background="{DynamicResource GlassPanelBackgroundBrush}">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Ready to seal"
                                       Foreground="{DynamicResource SectionLabelForegroundBrush}"
                                       FontSize="{StaticResource FontSizeCaption}"
                                       LetterSpacing="2" />
                            <TextBlock Text="FileCrypter writes the encrypted output locally and never keeps your password."
                                       Foreground="{DynamicResource MutedForegroundBrush}"
                                       TextWrapping="Wrap" />
                            <Button Classes="aurora-primary"
                                    Content="Seal file"
                                    Command="{Binding StartEncryptCommand}"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
