<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="FileCrypter.App.App"
             xmlns:local="using:FileCrypter.App"
             RequestedThemeVariant="Dark">

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>
  
    <Application.Styles>
        <FluentTheme />

        <Style Selector="Button, ToggleButton">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="MinHeight" Value="40" />
        </Style>

        <Style Selector="TextBox">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="MinHeight" Value="40" />
        </Style>

        <Style Selector="ToggleButton.nav-item">
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="20,10" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style Selector="ToggleButton.nav-item:checked">
            <Setter Property="Background" Value="#2d3440" />
            <Setter Property="Foreground" Value="#9cc4ff" />
        </Style>
    </Application.Styles>
</Application>
