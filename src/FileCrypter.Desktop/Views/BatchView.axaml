<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FileCrypter.Desktop.ViewModels"
             x:Class="FileCrypter.Desktop.Views.BatchView"
             x:DataType="vm:BatchViewModel">
    <ScrollViewer>
        <StackPanel Margin="36,30,36,36"
                    Spacing="24"
                    MaxWidth="1240">
            <Border IsVisible="{Binding HasError}"
                    Background="{DynamicResource ErrorBackgroundBrush}"
                    BorderBrush="{DynamicResource ErrorBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource ControlCornerRadius}"
                    Padding="18,16">
                <Grid ColumnDefinitions="*,Auto"
                      ColumnSpacing="16">
                    <TextBlock Text="{Binding VisibleErrorMessage}"
                               Foreground="{DynamicResource ErrorForegroundBrush}"
                               FontSize="{StaticResource FontSizeTitle}"
                               TextWrapping="Wrap" />
                    <Button Grid.Column="1"
                            Classes="aurora-secondary"
                            Content="Copy issue"
                            Command="{Binding CopyErrorCommand}"
                            VerticalAlignment="Center" />
                </Grid>
            </Border>

            <Grid ColumnDefinitions="*,360"
                  ColumnSpacing="20"
                  RowDefinitions="Auto,*">
                <StackPanel Grid.ColumnSpan="2"
                            Spacing="10">
                    <Border Classes="aurora-panel hero-badge"
                            HorizontalAlignment="Left"
                            Margin="0,0,0,14">
                        <TextBlock Classes="hero-badge-text"
                                   Text="{Binding ModeTitle}"
                                   Foreground="{DynamicResource AccentForegroundBrush}"
                                   TextWrapping="Wrap" />
                    </Border>
                </StackPanel>

                <StackPanel Grid.Row="1"
                            Spacing="18">
                    <Border Classes="aurora-card">
                        <StackPanel Spacing="16">
                            <TextBlock Text="WORKFLOW"
                                       Foreground="{DynamicResource SectionLabelForegroundBrush}"
                                       FontSize="{StaticResource FontSizeCaption}"
                                       LetterSpacing="2" />
                            <TextBlock Text="{Binding WorkflowChooserDescription}"
                                       Foreground="{DynamicResource MutedForegroundBrush}"
                                       TextWrapping="Wrap" />

                            <Grid ColumnDefinitions="*,*"
                                  ColumnSpacing="14">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="WHAT ARE YOU WORKING WITH?"
                                               Foreground="{DynamicResource SectionLabelForegroundBrush}"
                                               FontSize="{StaticResource FontSizeCaption}"
                                               LetterSpacing="1.5" />
                                    <RadioButton Classes="workflow-tile"
                                                 GroupName="BatchWorkflowType"
                                                 IsChecked="{Binding IndividualFilesMode}">
                                            <Grid RowDefinitions="Auto,*,Auto"
                                                  RowSpacing="10">
                                                <Viewbox Width="24"
                                                         Height="24"
                                                         HorizontalAlignment="Left">
                                                    <Path Classes="workflow-tile-icon"
                                                          Data="M4 4.25C4 3.00736 5.00736 2 6.25 2H10.5039V6.74753C10.5039 7.99017 11.5113 8.99753 12.7539 8.99753H17.5V17.25C17.5 18.4926 16.4926 19.5 15.25 19.5H6.25C5.00736 19.5 4 18.4926 4 17.25V4.25Z M12.0039 6.74753V2.46728C12.0803 2.52611 12.1532 2.59009 12.2221 2.65901L16.841 7.27786C16.9103 7.34721 16.9747 7.42062 17.0338 7.49753H12.7539C12.3397 7.49753 12.0039 7.16174 12.0039 6.74753Z" />
                                                </Viewbox>
                                                <TextBlock Grid.Row="1"
                                                           Text="Individual files"
                                                           FontSize="{StaticResource FontSizeTitle}"
                                                           FontWeight="SemiBold"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Grid.Row="2"
                                                           Text="{Binding IndividualFilesOptionDescription}"
                                                           Foreground="{DynamicResource MutedForegroundBrush}"
                                                           TextWrapping="Wrap" />
                                            </Grid>
                                    </RadioButton>
                                    <RadioButton Classes="workflow-tile"
                                                 GroupName="BatchWorkflowType"
                                                 IsChecked="{Binding ArchiveMode}">
                                            <Grid RowDefinitions="Auto,*,Auto"
                                                  RowSpacing="10">
                                                <Viewbox Width="24"
                                                         Height="24"
                                                         HorizontalAlignment="Left">
                                                    <Path Classes="workflow-tile-icon"
                                                          Data="M4 4.25C4 3.00736 5.00736 2 6.25 2H10.5039V6.74753C10.5039 7.99017 11.5113 8.99753 12.7539 8.99753H17.5V17.25C17.5 18.4926 16.4926 19.5 15.25 19.5H6.25C5.00736 19.5 4 18.4926 4 17.25V4.25Z M12.0039 6.74753V2.46728C12.0803 2.52611 12.1532 2.59009 12.2221 2.65901L16.841 7.27786C16.9103 7.34721 16.9747 7.42062 17.0338 7.49753H12.7539C12.3397 7.49753 12.0039 7.16174 12.0039 6.74753Z M8.75088 22C7.77121 22 6.93778 21.3739 6.62891 20.5H15.2509C17.0458 20.5 18.5009 19.0449 18.5009 17.25V8.93689L19.3419 9.77788C19.7638 10.1998 20.0009 10.7721 20.0009 11.3689V17.25C20.0009 19.8734 17.8742 22 15.2509 22H8.75088Z" />
                                                </Viewbox>
                                                <TextBlock Grid.Row="1"
                                                           Text="Encrypted archive"
                                                           FontSize="{StaticResource FontSizeTitle}"
                                                           FontWeight="SemiBold"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Grid.Row="2"
                                                           Text="{Binding ArchiveModeOptionDescription}"
                                                           Foreground="{DynamicResource MutedForegroundBrush}"
                                                           TextWrapping="Wrap" />
                                            </Grid>
                                    </RadioButton>
                                </StackPanel>

                                <StackPanel Grid.Column="1"
                                            Spacing="10">
                                    <TextBlock Text="WHAT SHOULD FILECRYPTER DO?"
                                               Foreground="{DynamicResource SectionLabelForegroundBrush}"
                                               FontSize="{StaticResource FontSizeCaption}"
                                               LetterSpacing="1.5" />
                                    <RadioButton Classes="workflow-tile"
                                                 GroupName="BatchWorkflowDirection"
                                                 IsChecked="{Binding EncryptMode}">
                                            <Grid RowDefinitions="Auto,*,Auto"
                                                  RowSpacing="10">
                                                <Viewbox Width="24"
                                                         Height="24"
                                                         HorizontalAlignment="Left">
                                                    <Path Classes="workflow-tile-icon"
                                                          Data="M12 1C14.7614 1 17 3.23858 17 6V8.00977C18.6781 8.13743 20 9.5392 20 11.25V18.75C20 20.5449 18.5449 22 16.75 22H7.25C5.45507 22 4 20.5449 4 18.75V11.25C4 9.5392 5.3219 8.13743 7 8.00977V6C7 3.23858 9.23858 1 12 1ZM12 13.75C11.3096 13.75 10.75 14.3096 10.75 15C10.75 15.6904 11.3096 16.25 12 16.25C12.6904 16.25 13.25 15.6904 13.25 15C13.25 14.3096 12.6904 13.75 12 13.75ZM12 2.5C10.067 2.5 8.5 4.067 8.5 6V8H15.5V6C15.5 4.067 13.933 2.5 12 2.5Z" />
                                                </Viewbox>
                                                <TextBlock Grid.Row="1"
                                                           Text="Encrypt"
                                                           FontSize="{StaticResource FontSizeTitle}"
                                                           FontWeight="SemiBold"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Grid.Row="2"
                                                           Text="{Binding EncryptActionDescription}"
                                                           Foreground="{DynamicResource MutedForegroundBrush}"
                                                           TextWrapping="Wrap" />
                                            </Grid>
                                    </RadioButton>
                                    <RadioButton Classes="workflow-tile"
                                                 GroupName="BatchWorkflowDirection"
                                                 IsChecked="{Binding IsDecryptMode}">
                                            <Grid RowDefinitions="Auto,*,Auto"
                                                  RowSpacing="10">
                                                <Viewbox Width="24"
                                                         Height="24"
                                                         HorizontalAlignment="Left">
                                                    <Path Classes="workflow-tile-icon"
                                                          Data="M18.75 1C21.3734 1 23.5 3.12665 23.5 5.75V6.25C23.5 6.66421 23.1642 7 22.75 7C22.3358 7 22 6.66421 22 6.25V5.75C22 3.95507 20.5449 2.5 18.75 2.5C16.9551 2.5 15.5 3.95507 15.5 5.75V8H16.75C18.5449 8 20 9.45507 20 11.25V18.75C20 20.5449 18.5449 22 16.75 22H7.25C5.45507 22 4 20.5449 4 18.75V11.25C4 9.45507 5.45507 8 7.25 8H14V5.75C14 3.12665 16.1266 1 18.75 1ZM12 13.75C11.3096 13.75 10.75 14.3096 10.75 15C10.75 15.6904 11.3096 16.25 12 16.25C12.6904 16.25 13.25 15.6904 13.25 15C13.25 14.3096 12.6904 13.75 12 13.75Z" />
                                                </Viewbox>
                                                <TextBlock Grid.Row="1"
                                                           Text="Decrypt"
                                                           FontSize="{StaticResource FontSizeTitle}"
                                                           FontWeight="SemiBold"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Grid.Row="2"
                                                           Text="{Binding DecryptActionDescription}"
                                                           Foreground="{DynamicResource MutedForegroundBrush}"
                                                           TextWrapping="Wrap" />
                                            </Grid>
                                    </RadioButton>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Classes="aurora-card"
                            x:Name="SourceDropZone">
                        <StackPanel Spacing="14">
                            <Grid ColumnDefinitions="*,Auto"
                                  ColumnSpacing="12">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{Binding SourceHeading}"
                                               Foreground="{DynamicResource SectionLabelForegroundBrush}"
                                               FontSize="{StaticResource FontSizeCaption}"
                                               LetterSpacing="2" />
                                    <TextBlock Text="{Binding FilesSummaryText}"
                                               Foreground="{DynamicResource MutedForegroundBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Classes="aurora-secondary"
                                        Content="Clear list"
                                        Command="{Binding ClearFilesCommand}"
                                        VerticalAlignment="Center" />
                            </Grid>

                            <Border Classes="file-drop-zone">
                                <Grid>
                                    <StackPanel IsVisible="{Binding ShowEmptySourceState}"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Spacing="10">
                                        <Border Width="82"
                                                Height="82"
                                                CornerRadius="{StaticResource ControlCornerRadius}"
                                                Background="{DynamicResource NavigationSelectedBackgroundBrush}"
                                                BorderBrush="{DynamicResource SurfaceBorderBrush}"
                                                BorderThickness="1">
                                            <Viewbox Width="30"
                                                     Height="30"
                                                     HorizontalAlignment="Center"
                                                     VerticalAlignment="Center">
                                                <Path Classes="file-preview-icon"
                                                      Data="M6 2 H14 L20 8 V22 H6 Z M14 2 V8 H20 M12 10 V18 M9 13 L12 10 L15 13 M9 18 H15" />
                                            </Viewbox>
                                        </Border>
                                        <TextBlock Text="Drop files here to build the queue"
                                                   FontSize="18"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Center" />
                                        <TextBlock Text="Click to add files or drag them directly into the queue."
                                                   Foreground="{DynamicResource MutedForegroundBrush}"
                                                   HorizontalAlignment="Center"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>

                                    <ScrollViewer IsVisible="{Binding HasSelectedFiles}"
                                                  MaxHeight="360"
                                                  VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding SourceFilePreviews}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:FileSelectionPreviewViewModel">
                                                    <Border Classes="file-preview-row"
                                                            Margin="0,0,0,10">
                                                        <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto"
                                                              ColumnSpacing="14"
                                                              VerticalAlignment="Center">
                                                            <Border Width="38"
                                                                    Height="38"
                                                                    CornerRadius="{StaticResource ControlCornerRadius}"
                                                                    Background="{DynamicResource NavigationSelectedBackgroundBrush}"
                                                                    BorderBrush="{DynamicResource SurfaceBorderBrush}"
                                                                    BorderThickness="1">
                                                                <Viewbox Width="18"
                                                                         Height="18"
                                                                         HorizontalAlignment="Center"
                                                                         VerticalAlignment="Center">
                                                                    <Path Classes="file-preview-icon"
                                                                          Data="{Binding IconPathData}" />
                                                                </Viewbox>
                                                            </Border>
                                                            <StackPanel Grid.Column="1"
                                                                        Spacing="3"
                                                                        VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding DisplayName}"
                                                                           ToolTip.Tip="{Binding FullPath}"
                                                                           FontSize="{StaticResource FontSizeTitle}"
                                                                           FontWeight="SemiBold"
                                                                           TextWrapping="NoWrap"
                                                                           TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Text="{Binding FullPath}"
                                                                           Foreground="{DynamicResource MutedForegroundBrush}"
                                                                           FontSize="{StaticResource FontSizeCaption}"
                                                                           TextWrapping="NoWrap"
                                                                           TextTrimming="CharacterEllipsis" />
                                                            </StackPanel>
                                                            <TextBlock Grid.Column="2"
                                                                       Text="{Binding SizeText}"
                                                                       Foreground="{DynamicResource SectionLabelForegroundBrush}"
                                                                       VerticalAlignment="Center" />
                                                            <TextBlock Grid.Column="3"
                                                                       Text="Queued"
                                                                       Foreground="{DynamicResource AccentForegroundBrush}"
                                                                       VerticalAlignment="Center"
                                                                       FontSize="{StaticResource FontSizeCaption}"
                                                                       LetterSpacing="1.5" />
                                                            <Button Grid.Column="4"
                                                                    Classes="file-preview-remove"
                                                                    Content="x"
                                                                    Command="{Binding RemoveCommand}"
                                                                    ToolTip.Tip="Remove file from queue" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Classes="aurora-card"
                            IsVisible="{Binding HasResults}">
                        <StackPanel Spacing="14">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="{Binding ResultSummary}"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap" />
                                <Button Grid.Column="1"
                                        Classes="aurora-secondary"
                                        Content="Copy results"
                                        Command="{Binding CopyResultsCommand}"
                                        VerticalAlignment="Center" />
                            </Grid>

                            <ItemsControl ItemsSource="{Binding Results}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:BatchResultItemViewModel">
                                        <Border Classes="aurora-panel"
                                                Margin="0,0,0,10">
                                            <StackPanel Spacing="6">
                                                <TextBlock Text="{Binding StatusLabel}"
                                                           Foreground="{Binding StatusBrush}"
                                                           FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding TitleText}"
                                                           FontSize="{StaticResource FontSizeTitle}"
                                                           FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding PrimaryText}"
                                                           Foreground="{DynamicResource MutedForegroundBrush}"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding DetailLabel}"
                                                           Foreground="{DynamicResource SectionLabelForegroundBrush}"
                                                           FontSize="{StaticResource FontSizeCaption}"
                                                           LetterSpacing="1.5" />
                                                <TextBlock Text="{Binding DetailText}"
                                                           Foreground="{Binding DetailBrush}"
                                                           TextWrapping="Wrap" />
                                                <TextBlock IsVisible="{Binding HasSecondaryText}"
                                                           Text="{Binding SecondaryText}"
                                                           Foreground="{DynamicResource SectionLabelForegroundBrush}"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Grid.Row="1"
                            Spacing="16">
                    <Border Classes="aurora-card">
                        <StackPanel Spacing="10">
                            <TextBlock Text="{Binding QueueInspectorTitle}"
                                       Foreground="{DynamicResource SectionLabelForegroundBrush}"
                                       FontSize="{StaticResource FontSizeCaption}"
                                       LetterSpacing="2" />
                            <TextBlock Text="{Binding QueueInspectorBody}"
                                       FontFamily="Cascadia Mono, Consolas, monospace"
                                       Foreground="{DynamicResource AccentForegroundBrush}"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{Binding ProgressText}"
                                       Foreground="{DynamicResource MutedForegroundBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Expander Classes="compact-section"
                              IsExpanded="True">
                        <Expander.Header>
                            <StackPanel Spacing="3">
                                <TextBlock Text="{Binding OutputHeading}"
                                           Foreground="{DynamicResource SectionLabelForegroundBrush}"
                                           FontSize="{StaticResource FontSizeCaption}"
                                           LetterSpacing="2" />
                                <TextBlock Text="{Binding OutputDescription}"
                                           Foreground="{DynamicResource MutedForegroundBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Expander.Header>
                        <StackPanel Margin="0,14,0,0"
                                    Spacing="12">
                            <Grid ColumnDefinitions="*,Auto"
                                  ColumnSpacing="12">
                                <TextBox Text="{Binding OutputDirectory}"
                                         PlaceholderText="Choose an existing output folder..." />
                                <Button Grid.Column="1"
                                        Classes="aurora-secondary"
                                        Content="Browse"
                                        Command="{Binding BrowseOutputDirectoryCommand}" />
                            </Grid>
                        </StackPanel>
                    </Expander>

                    <Expander Classes="compact-section"
                              IsExpanded="True">
                        <Expander.Header>
                            <StackPanel Spacing="4">
                                <TextBlock Text="PASSPHRASE"
                                           Foreground="{DynamicResource SectionLabelForegroundBrush}"
                                           FontSize="{StaticResource FontSizeCaption}"
                                           LetterSpacing="2" />
                                <TextBlock Text="Use something memorable but uncommon."
                                           Foreground="{DynamicResource MutedForegroundBrush}" />
                            </StackPanel>
                        </Expander.Header>
                        <StackPanel Margin="0,14,0,0"
                                    Spacing="14">

                            <TextBox Text="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     PasswordChar="*"
                                     RevealPassword="{Binding ShowPassword}"
                                     PlaceholderText="Enter the batch passphrase" />

                            <StackPanel Spacing="6">
                                <ProgressBar Classes="aurora-progress"
                                             Minimum="0"
                                             Maximum="100"
                                             Value="{Binding PasswordStrengthPercent}" />
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{Binding PasswordStrengthLabel}"
                                               Foreground="{DynamicResource SectionLabelForegroundBrush}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding PasswordStrengthDetail}"
                                               Foreground="{DynamicResource SectionLabelForegroundBrush}"
                                               FontFamily="Cascadia Mono, Consolas, monospace"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal"
                                        Spacing="10">
                                <Button Classes="aurora-secondary"
                                        Content="Generate">
                                    <Button.Flyout>
                                        <MenuFlyout>
                                            <MenuItem Header="Random password"
                                                      Command="{Binding GenerateRandomPasswordCommand}" />
                                            <MenuItem Header="Memorable passphrase"
                                                      Command="{Binding GenerateMemorablePassphraseCommand}" />
                                        </MenuFlyout>
                                    </Button.Flyout>
                                </Button>
                                <Button Classes="aurora-secondary"
                                        Content="{Binding PasswordVisibilityActionText}"
                                        Command="{Binding TogglePasswordVisibilityCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </Expander>

                    <Border Classes="aurora-card"
                            IsVisible="{Binding ShowBatchReadyAction}"
                            Background="{DynamicResource GlassPanelBackgroundBrush}">
                        <StackPanel Spacing="12">
                            <TextBlock Text="READY TO RUN"
                                       Foreground="{DynamicResource SectionLabelForegroundBrush}"
                                       FontSize="{StaticResource FontSizeCaption}"
                                       LetterSpacing="2" />
                            <TextBlock Text="The selected workflow, output folder, and passphrase apply to the whole queue."
                                       Foreground="{DynamicResource MutedForegroundBrush}"
                                       TextWrapping="Wrap" />
                            <Button Classes="aurora-primary"
                                    Content="{Binding ActionButtonText}"
                                    Command="{Binding StartBatchCommand}"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <Expander Classes="compact-section"
                              IsExpanded="{Binding IsAdvancedOptionsExpanded}">
                        <Expander.Header>
                            <StackPanel Spacing="3">
                                <TextBlock Text="ADVANCED OPTIONS"
                                           Foreground="{DynamicResource SectionLabelForegroundBrush}"
                                           FontSize="{StaticResource FontSizeCaption}"
                                           LetterSpacing="2" />
                                <TextBlock Text="Archive naming, optional key-file, overwrite handling, and queue safety details."
                                           Foreground="{DynamicResource MutedForegroundBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Expander.Header>
                        <StackPanel Margin="0,14,0,0"
                                    Spacing="16">
                            <StackPanel IsVisible="{Binding ShowArchiveNameEditor}"
                                        Spacing="8">
                                <TextBlock Text="ARCHIVE NAME"
                                           Foreground="{DynamicResource SectionLabelForegroundBrush}"
                                           FontSize="{StaticResource FontSizeCaption}"
                                           LetterSpacing="2" />
                                <TextBox Text="{Binding ArchiveName}"
                                         PlaceholderText="Optional archive name, like project-docs" />
                                <TextBlock Text="{Binding ArchiveNameStatusText}"
                                           Foreground="{DynamicResource SectionLabelForegroundBrush}"
                                           Margin="30,0,0,0"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <CheckBox IsChecked="{Binding NeverOverwriteExistingFiles}"
                                      Content="Never overwrite existing files" />
                            <TextBlock Text="FileCrypter auto-renames each destination when that folder already contains a matching name."
                                       Foreground="{DynamicResource SectionLabelForegroundBrush}"
                                       Margin="30,0,0,0"
                                       TextWrapping="Wrap" />

                            <StackPanel Spacing="8">
                                <TextBlock Text="OPTIONAL KEY FILE"
                                           Foreground="{DynamicResource SectionLabelForegroundBrush}"
                                           FontSize="{StaticResource FontSizeCaption}"
                                           LetterSpacing="2" />
                                <TextBlock Text="{Binding KeyFileChoiceStatusText}"
                                           Foreground="{DynamicResource AccentForegroundBrush}"
                                           TextWrapping="Wrap" />
                                <TextBox Text="{Binding KeyFilePath}"
                                         PlaceholderText="Optional batch key file..." />
                                <StackPanel Orientation="Horizontal"
                                            Spacing="10">
                                    <Button Classes="aurora-secondary"
                                            Content="Browse"
                                            Command="{Binding BrowseKeyFileCommand}" />
                                    <Button Classes="aurora-secondary"
                                            Content="Clear"
                                            Command="{Binding ClearKeyFileCommand}" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Expander>

                    <Border Classes="aurora-card"
                            IsVisible="{Binding IsRunning}">
                        <StackPanel Spacing="12">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="Running queue"
                                           FontWeight="SemiBold" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding ProgressPercent, StringFormat={}{0:0}%}"
                                           Foreground="{DynamicResource AccentSecondaryForegroundBrush}"
                                           FontFamily="Cascadia Mono, Consolas, monospace" />
                            </Grid>
                            <ProgressBar Minimum="0"
                                         Maximum="100"
                                         Value="{Binding ProgressPercent}" />
                            <TextBlock Text="{Binding ProgressText}"
                                       Foreground="{DynamicResource MutedForegroundBrush}"
                                       TextWrapping="Wrap" />
                            <Button Classes="aurora-secondary"
                                    Content="Cancel"
                                    Command="{Binding CancelCommand}"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center" />
                        </StackPanel>
                    </Border>

                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
