<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FileCrypter.Desktop.ViewModels"
             x:Class="FileCrypter.Desktop.Views.DecryptView"
             x:DataType="vm:DecryptViewModel">
    <ScrollViewer>
        <StackPanel Margin="36,30,36,36"
                    Spacing="24"
                    MaxWidth="1220">
            <Border IsVisible="{Binding HasError}"
                    Background="{DynamicResource ErrorBackgroundBrush}"
                    BorderBrush="{DynamicResource ErrorBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource ControlCornerRadius}"
                    Padding="18,16">
                <Grid ColumnDefinitions="*,Auto"
                      ColumnSpacing="16">
                    <TextBlock Text="{Binding VisibleErrorMessage}"
                               Foreground="{DynamicResource ErrorForegroundBrush}"
                               FontSize="{StaticResource FontSizeTitle}"
                               TextWrapping="Wrap" />
                    <Button Grid.Column="1"
                            Classes="aurora-secondary"
                            Content="Copy issue"
                            Command="{Binding CopyErrorCommand}"
                            VerticalAlignment="Center" />
                </Grid>
            </Border>

            <Grid ColumnDefinitions="*,360"
                  ColumnSpacing="20"
                  RowDefinitions="Auto,*">
                <StackPanel Grid.ColumnSpan="2"
                            Spacing="10">
                    <Border Classes="aurora-panel hero-badge"
                            HorizontalAlignment="Left"
                            Margin="0,0,0,14">
                        <TextBlock Classes="hero-badge-text"
                                   Text="{Binding HeroTitle}"
                                   Foreground="{DynamicResource AccentSecondaryForegroundBrush}"
                                   TextWrapping="Wrap" />
                    </Border>
                </StackPanel>

                <StackPanel Grid.Row="1"
                            Spacing="18">
                    <Border Classes="aurora-card"
                            x:Name="SourceDropZone">
                        <Border Classes="file-drop-zone">
                            <Grid>
                                <StackPanel IsVisible="{Binding ShowEmptySourceState}"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Spacing="10">
                                    <Border Width="82"
                                            Height="82"
                                            CornerRadius="{StaticResource ControlCornerRadius}"
                                            Background="{DynamicResource NavigationSelectedBackgroundBrush}"
                                            BorderBrush="{DynamicResource SurfaceBorderBrush}"
                                            BorderThickness="1">
                                        <Viewbox Width="30"
                                                 Height="30"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center">
                                            <Path Classes="workflow-tile-icon"
                                                  Data="M18.75 1C21.3734 1 23.5 3.12665 23.5 5.75V6.25C23.5 6.66421 23.1642 7 22.75 7C22.3358 7 22 6.66421 22 6.25V5.75C22 3.95507 20.5449 2.5 18.75 2.5C16.9551 2.5 15.5 3.95507 15.5 5.75V8H16.75C18.5449 8 20 9.45507 20 11.25V18.75C20 20.5449 18.5449 22 16.75 22H7.25C5.45507 22 4 20.5449 4 18.75V11.25C4 9.45507 5.45507 8 7.25 8H14V5.75C14 3.12665 16.1266 1 18.75 1ZM12 13.75C11.3096 13.75 10.75 14.3096 10.75 15C10.75 15.6904 11.3096 16.25 12 16.25C12.6904 16.25 13.25 15.6904 13.25 15C13.25 14.3096 12.6904 13.75 12 13.75Z" />
                                        </Viewbox>
                                    </Border>
                                    <TextBlock Text="Drop an encrypted file"
                                               FontSize="18"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center" />
                                    <TextBlock Text="Click to browse or drag a local .encrypted file here."
                                               Foreground="{DynamicResource MutedForegroundBrush}"
                                               HorizontalAlignment="Center"
                                               TextWrapping="Wrap" />
                                </StackPanel>

                                <Border IsVisible="{Binding HasSelectedFile}"
                                        Classes="file-preview-row"
                                        VerticalAlignment="Center">
                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto"
                                          ColumnSpacing="16">
                                        <Border Width="56"
                                                Height="66"
                                                CornerRadius="{StaticResource ControlCornerRadius}"
                                                Background="{DynamicResource NavigationSelectedBackgroundBrush}"
                                                BorderBrush="{DynamicResource SurfaceBorderBrush}"
                                                BorderThickness="1">
                                            <Viewbox Width="24"
                                                     Height="24"
                                                     HorizontalAlignment="Center"
                                                     VerticalAlignment="Center">
                                                <Path Classes="file-preview-icon"
                                                      Data="{Binding SourcePreview.IconPathData}" />
                                            </Viewbox>
                                        </Border>
                                        <StackPanel Grid.Column="1"
                                                    Spacing="4"
                                                    VerticalAlignment="Center">
                                            <TextBlock Text="{Binding SourcePreview.DisplayName}"
                                                       ToolTip.Tip="{Binding SourcePreview.FullPath}"
                                                       FontSize="{StaticResource FontSizeTitle}"
                                                       FontWeight="SemiBold"
                                                       TextWrapping="NoWrap"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding SourcePreview.SizeText}"
                                                       Foreground="{DynamicResource SectionLabelForegroundBrush}" />
                                            <TextBlock Text="{Binding OutputDisplayText}"
                                                       Foreground="{DynamicResource AccentSecondaryForegroundBrush}"
                                                       FontSize="{StaticResource FontSizeCaption}"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2"
                                                   Text="ENCRYPTED"
                                                   Foreground="{DynamicResource SectionLabelForegroundBrush}"
                                                   VerticalAlignment="Center"
                                                   FontSize="{StaticResource FontSizeCaption}"
                                                   LetterSpacing="2" />
                                        <Button Grid.Column="3"
                                                Classes="file-preview-remove"
                                                Content="x"
                                                Command="{Binding ClearSourceCommand}"
                                                ToolTip.Tip="Clear selected file" />
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                    </Border>

                    <Border Classes="aurora-card"
                            Background="{DynamicResource GlassPanelBackgroundBrush}">
                        <StackPanel Spacing="12">
                            <TextBlock Text="READY TO DECRYPT"
                                       Foreground="{DynamicResource SectionLabelForegroundBrush}"
                                       FontSize="{StaticResource FontSizeCaption}"
                                       LetterSpacing="2" />
                            <TextBlock Text="FileCrypter restores the file locally and keeps the original source untouched."
                                       Foreground="{DynamicResource MutedForegroundBrush}"
                                       TextWrapping="Wrap" />
                            <Button Classes="aurora-primary"
                                    Content="Decrypt file"
                                    Command="{Binding StartDecryptCommand}"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center" />
                        </StackPanel>
                    </Border>

                </StackPanel>

                <StackPanel Grid.Column="1"
                            Grid.Row="1"
                            Spacing="16">
                    <Border Classes="aurora-card">
                        <StackPanel Spacing="10">
                            <TextBlock Text="{Binding DetailsPanelTitle}"
                                       Foreground="{DynamicResource SectionLabelForegroundBrush}"
                                       FontSize="{StaticResource FontSizeCaption}"
                                       LetterSpacing="2" />
                            <TextBlock Text="{Binding DetailsPanelBody}"
                                       FontFamily="Cascadia Mono, Consolas, monospace"
                                       Foreground="{DynamicResource AccentSecondaryForegroundBrush}"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="If a key file was used during encryption, the original unchanged file is required here too."
                                       Foreground="{DynamicResource MutedForegroundBrush}"
                                       TextWrapping="Wrap" />
                            <Button Classes="aurora-secondary"
                                    IsVisible="{Binding HasResult}"
                                    Content="Copy result"
                                    Command="{Binding CopyResultCommand}"
                                    HorizontalAlignment="Left" />
                        </StackPanel>
                    </Border>

                    <Expander Classes="compact-section"
                              IsExpanded="True">
                        <Expander.Header>
                            <StackPanel Spacing="4">
                                <TextBlock Text="PASSPHRASE"
                                           Foreground="{DynamicResource SectionLabelForegroundBrush}"
                                           FontSize="{StaticResource FontSizeCaption}"
                                           LetterSpacing="2" />
                                <TextBlock Text="Enter the original passphrase. Add the matching key file in Advanced Options when the payload requires one."
                                           Foreground="{DynamicResource MutedForegroundBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Expander.Header>
                        <StackPanel Margin="0,14,0,0"
                                    Spacing="14">
                            <TextBox Text="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     PasswordChar="*"
                                     RevealPassword="{Binding ShowPassword}"
                                     PlaceholderText="Enter the original password" />
                            <TextBlock Text="Compressed files are decompressed automatically after authenticated decryption."
                                       Foreground="{DynamicResource SectionLabelForegroundBrush}"
                                       TextWrapping="Wrap" />
                            <Button Classes="aurora-secondary"
                                    Content="{Binding PasswordVisibilityActionText}"
                                    Command="{Binding TogglePasswordVisibilityCommand}"
                                    HorizontalAlignment="Left" />
                        </StackPanel>
                    </Expander>

                    <Border Classes="aurora-card"
                            IsVisible="{Binding IsRunning}">
                        <StackPanel Spacing="12">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="Opening vault"
                                           FontWeight="SemiBold" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding ProgressPercent, StringFormat={}{0:0}%}"
                                           Foreground="{DynamicResource AccentSecondaryForegroundBrush}"
                                           FontFamily="Cascadia Mono, Consolas, monospace" />
                            </Grid>
                            <ProgressBar Minimum="0"
                                         Maximum="100"
                                         Value="{Binding ProgressPercent}" />
                            <TextBlock Text="{Binding ProgressText}"
                                       Foreground="{DynamicResource MutedForegroundBrush}"
                                       TextWrapping="Wrap" />
                            <Button Classes="aurora-secondary"
                                    Content="Cancel"
                                    Command="{Binding CancelCommand}"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <Expander Classes="compact-section"
                              IsExpanded="{Binding IsAdvancedOptionsExpanded}">
                        <Expander.Header>
                            <StackPanel Spacing="3">
                                <TextBlock Text="ADVANCED OPTIONS"
                                           Foreground="{DynamicResource SectionLabelForegroundBrush}"
                                           FontSize="{StaticResource FontSizeCaption}"
                                           LetterSpacing="2" />
                                <TextBlock Text="Output naming, overwrite protection, and optional key-file mode for the restored file."
                                           Foreground="{DynamicResource MutedForegroundBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Expander.Header>
                        <StackPanel Margin="0,14,0,0"
                                    Spacing="16">
                            <StackPanel Spacing="8">
                                <TextBlock Text="OUTPUT FILE"
                                           Foreground="{DynamicResource SectionLabelForegroundBrush}"
                                           FontSize="{StaticResource FontSizeCaption}"
                                           LetterSpacing="2" />
                                <Grid ColumnDefinitions="*,Auto"
                                      ColumnSpacing="12">
                                    <TextBox Text="{Binding OutputPath}"
                                             PlaceholderText="Auto-generated from input filename..." />
                                    <Button Grid.Column="1"
                                            Classes="aurora-secondary"
                                            Content="Browse"
                                            Command="{Binding BrowseOutputCommand}" />
                                </Grid>
                            </StackPanel>

                            <CheckBox IsChecked="{Binding NeverOverwriteExistingFiles}"
                                      Content="Never overwrite existing files" />

                            <TextBlock Text="{Binding KeyFileChoiceStatusText}"
                                       Foreground="{DynamicResource AccentForegroundBrush}"
                                       TextWrapping="Wrap" />

                            <Grid ColumnDefinitions="*,Auto"
                                  ColumnSpacing="10">
                                <TextBox Text="{Binding KeyFilePath}"
                                         PlaceholderText="Optional matching key file..." />
                                <Button Grid.Column="1"
                                        Classes="aurora-secondary"
                                        Content="Browse"
                                        Command="{Binding BrowseKeyFileCommand}" />
                            </Grid>
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
